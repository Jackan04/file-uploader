<div class="table">
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Type</th>
        <th>Size</th>
        <th>Created At</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% files.forEach((file) => { %>
        <% const menuId = `file-menu-${file.id}`; %>
        <tr>
          <td class="hstack">
            <i class="fa-regular fa-file"></i>
            <a href="/drive/files/download/<%= file.id %>"><b><%= file.name %></b></a>
            
          </td>
          <td>
            <%= file.resourceType %>
          </td>
          <td><%= file.size %></td>
          <td>
            <p><%= file.createdAt %></p>
          </td>
          <td>
            <ot-dropdown>
              <button popovertarget="<%= menuId %>" class="outline small">
                Actions
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </button>
              <menu popover id="<%= menuId %>">
                <a role="menuitem" href="/drive/files/download/<%= file.id %>"><i class="fa-solid fa-download"></i> Download</a>
                <a
                  role="menuitem"
                  href="/drive/files/update/<%= file.id %>"
                >
                  <i class="fa-solid fa-pen-to-square"></i> Edit
                </a>
                <form
                  action="/drive/files/delete/<%= file.id %>"
                  method="post"
                >
                  <button role="menuitem" type="submit" ><i class="fa-solid fa-trash"></i> Delete</button>
                </form>
              </menu>
            </ot-dropdown>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>