<!DOCTYPE html>
<html lang="en">
  <%- include("../partials/head.ejs") %>
  <body>
    <div class="container">
      <%- include("../partials/header.ejs") %> <%-
      include("../partials/page-title.ejs") %>

      <form action="/auth/sign-up" method="post">
        <%- include("../partials/validationErrors.ejs") %>
        <label for="username">
          Username
          <input
            data-field
            type="text"
            id="username"
            name="username"
            placeholder="Username"
          />
        </label>
        <label for="password">
          Password
          <input
            data-field
            type="password"
            id="password"
            name="password"
            placeholder="Password"
          />
        </label>
        <button type="submit">Sign Up</button>
      </form>
    </div>
  </body>
</html>
